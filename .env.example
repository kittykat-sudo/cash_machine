# Docker Compose Environment Template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cash_register
HOST_DB_PORT=5433
HOST_REDIS_PORT=6380

DATABASE_URL=postgresql://postgres:postgres@db:5432/cash_register
REDIS_URL=redis://redis:6379/0
JWT_SECRET=chathura-printers-super-secret-jwt-key-2026

APP_TIMEZONE=Asia/Colombo
DEFAULT_CURRENCY=LKR

SHOP_NAME=Chathura Printers
SHOP_PHONE=072 0129297 / 077-8683088
SHOP_WHATSAPP_NUMBER=0720129297
SHOP_ADDRESS=No. 6A, Sri Hemananda Mw, Joolgaha, Galle

# WhatsApp Integration
# WHATSAPP_MODE: 'click_to_chat' (default, free instant wa.me links) | 'cloud_api' (Meta Cloud API) | 'twilio'
